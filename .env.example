# Banco de dados (dev e prod)
DB_NAME=agro_backend
DB_USER=user
DB_PASSWORD=password
DB_PORT=5433

# Aplicação
# Gere uma chave forte de pelo menos 32 bytes (ex.: openssl rand -base64 48)
JWT_SECRET=

# CORS — origens permitidas (vírgula-separadas). Em dev o frontend roda em :3000.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Variáveis usadas apenas em produção (docker-compose.prod.yml)
# Copie este arquivo para .env.prod e ajuste os valores. NUNCA versionar.
# ---------------------------------------------------------------------------

# URL pública da API (onde o browser chama o backend). Troque pelo domínio real em prod.
PUBLIC_API_URL=http://localhost:8080

# URL pública do frontend (origem do browser). É o valor que o backend libera no CORS.
PUBLIC_FRONTEND_URL=http://localhost:3000

# Em prod a aplicação se conecta ao container `db` pela rede interna.
# Esta variável já é setada automaticamente em docker-compose.prod.yml; ignore em dev.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/${DB_NAME}
